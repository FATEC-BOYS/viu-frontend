# VIU Backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública deste app (links absolutos). Na Vercel, VERCEL_URL supre isso.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile no cadastro.
# A presença desta chave é o interruptor do widget: sem ela o formulário sobe
# sem captcha, que é como se desenvolve local. Precisa combinar com
# CAPTCHA_ENABLED=true no backend — widget sem validação no servidor não
# protege nada, e validação sem widget recusa todo cadastro do navegador.
# Chaves em: dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# OpenAI (TTS e transcrição são processados no backend — não expor aqui em produção)
OPENAI_API_KEY=
